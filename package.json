  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mercadopago": "^3.6.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.0",
    "pdfkit": "^0.17.2",
    "sequelize": "^6.37.3",
    "stripe": "^16.9.0"
