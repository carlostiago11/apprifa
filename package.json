{
  "name": "apprifa",
  "version": "1.0.0",
  "description": "Rifa app with Docker, MySQL and payment API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test:api": "node --test tests/api.test.js",
    "test:api:isolated": "bash scripts/test-api-isolated.sh",
    "test:ci": "bash scripts/test-ci.sh",
    "test:pix": "node --test tests/pix.test.js",
    "test:pix:isolated": "bash scripts/test-pix-isolated.sh",
    "check:mercadopago": "node scripts/check-mercadopago.js",
    "validate:mercadopago": "bash scripts/validate-mercadopago.sh",
